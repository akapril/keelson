# Rust / Tauri
/src-tauri/target/
**/*.rs.bk
*.pdb

# Node / frontend
node_modules/
/dist/
/frontend/dist/
.vite/
*.local

# TypeScript 增量构建产物
*.tsbuildinfo

# VitePress 文档站构建产物 / 缓存
docs/.vitepress/dist
docs/.vitepress/cache

# PocketBase runtime data (never commit)
