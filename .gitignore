# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Env / secrets
.env
.env.*
!.env.example

# Claude Code 本地配置
.claude/

# tauri icon 生成的移动端图标(桌面项目未用)
src-tauri/icons/android/
src-tauri/icons/ios/
.demo-pb/

# 独立迁移工具的本地编译产物（源码 .rs 才提交）
scripts/*.exe
scripts/*.pdb
