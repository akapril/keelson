{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keelson Mobile",
  "version": "0.1.0",
  "identifier": "com.keelson.mobile",
  "build": {
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "node ../../node_modules/vite/bin/vite.js --config vite.config.ts",
    "beforeBuildCommand": "node ../../node_modules/vite/bin/vite.js build --config vite.config.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Keelson", "width": 430, "height": 860 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
