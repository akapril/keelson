{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rework",
  "version": "0.1.0",
  "identifier": "com.rework.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rework",
        "width": 1200,
        "height": 800,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false
      },
      {
        "label": "spotlight",
        "title": "rework spotlight",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "width": 640,
        "height": 420,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENzc0ODI2RTRCOTY1QgpSV1JibGt0dWduVFhEczBYMUpWRFZWWG1EL0FGdS9rZzdkMVM5Y25FbTNhWjJNZG9uYWN5c1ZoUgo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pocketbase", "binaries/claude-runtime"],
    "resources": ["pb_migrations/*"]
  }
}
