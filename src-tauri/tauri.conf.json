{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keelson",
  "version": "../package.json",
  "identifier": "com.rework.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keelson",
        "width": 1200,
        "height": 800,
        "minWidth": 920,
        "minHeight": 640,
        "decorations": false
      },
      {
        "label": "spotlight",
        "title": "Keelson Spotlight",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": true,
        "width": 640,
        "height": 420,
        "resizable": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; worker-src 'self' blob:; media-src 'self' data: blob:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/akapril/keelson/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QUMwMzM4OTkzNTNGNzYKUldSMlB6V1pPQU9zeHNvNElEaEtlZm1mclcrNkR4T2V2T0srUmFXODJXNlpFa2JzVTl3czlUaDMK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pocketbase"],
    "resources": {
      "pb_migrations/*": "pb_migrations/",
      "../dist": "dist/"
    }
  }
}
